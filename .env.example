# Supabase project URL (Dashboard > Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon key (Dashboard > Settings > API)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional override for the public GitHub repo used for APK releases
EXPO_PUBLIC_APP_UPDATE_GITHUB_REPO=mattcastells/nossa-clima

# Optional override for the Supabase Edge Function name used by the AI assistant
EXPO_PUBLIC_AI_FUNCTION_NAME=assistant-chat

# --- Relevamiento de proveedores (tools/supplier-survey) ---
# Usuario con el que el relevamiento LEE la base (anon key + login, nunca
# service_role). Si no estan, cae a KEEPALIVE_EMAIL / KEEPALIVE_PASSWORD.
SURVEY_SUPABASE_EMAIL=
SURVEY_SUPABASE_PASSWORD=

# Usuario al que se atribuyen los cambios en el SQL generado.
# Si esta vacio, se usa el primer usuario de auth.users.
SURVEY_DB_ACTOR_EMAIL=

# Buscadores del discovery. Opcionales: sin ninguno, el discovery lee
# tools/supplier-survey/seeds/candidates.json.
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=

# Dev only: inline dynamic imports (jspdf) into the main bundle. Metro's lazy
# chunks break with "Requiring unknown module" when the page and the server
# get out of sync (server restarts, cached bundles).
EXPO_NO_METRO_LAZY=1
